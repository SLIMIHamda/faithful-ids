{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schema/generator.v1.json",
  "title": "Generator config (the paper's axis)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "kind", "code", "llm_dependent", "params"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "schema_version": {"const": "v1"},
    "kind": {"const": "generator"},
    "code": {"enum": ["b0_raw_shap", "b1_template", "b2_zeroshot", "b3_dte_style", "b1l_llm_render", "b4_vte", "b5_narrative_vte"]},
    "llm_dependent": {"type": "boolean"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_k", "temperature"],
      "properties": {
        "top_k": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "max_new_tokens": {
          "type": "integer", "minimum": 1,
          "description": "Reply cap for LLM generation (amendment 0007). Sent with every call, so it is part of the ledger's request hash: generations under different caps never share a cache entry. Absent = the provider default (160), which truncated B3-B5."
        }
      }
    },
    "prompt": {"$ref": "#/$defs/prompt_ref"},
    "prompt_multiclass": {"$ref": "#/$defs/prompt_ref"},
    "kb_ref": {"type": ["string", "null"], "pattern": "^kb:[a-z0-9_]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kb_class_ref": {"type": ["string", "null"], "pattern": "^kb:[a-z0-9_]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "verifier": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["model_family", "prompt", "threshold_ref"],
      "properties": {
        "model_family": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "prompt": {"$ref": "#/$defs/prompt_ref"},
        "threshold_ref": {"type": "string", "pattern": "^statistics:decision_thresholds:[a-z0-9_]+$"},
        "threshold_scope": {"const": "dev_split"},
        "model": {"$ref": "#/$defs/pinned_ollama_model"}
      }
    },
    "abstention": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["enabled", "fallback_generator", "reporting"],
      "properties": {
        "enabled": {"type": "boolean"},
        "fallback_generator": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "reporting": {"const": "coverage_risk"}
      }
    }
  },
  "$defs": {
    "prompt_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "pinned_ollama_model": {
      "type": "object",
      "description": "The pinned model the verifier runs (amendment 0008): an Ollama-library 4-bit build of base_model. The run refuses to start unless the blobs Ollama serves match these sha256s.",
      "additionalProperties": false,
      "required": ["id", "provider", "quantisation", "runtime", "base_model", "weights", "ollama"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "provider": {"const": "local_open_weights"},
        "quantisation": {"enum": ["none", "4bit"]},
        "runtime": {"const": "ollama"},
        "base_model": {"type": "string"},
        "licence": {"type": "string"},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "ref", "revision", "sha256"],
          "properties": {
            "source": {"const": "ollama_library"},
            "ref": {"type": "string", "pattern": "^[a-z0-9._-]+:[A-Za-z0-9._-]+$"},
            "revision": {"type": "string", "description": "Ledger snapshot id: the weights blob digest (a library tag can move; the digest cannot)."},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_name", "template_sha256", "min_version"],
          "properties": {
            "model_name": {"type": "string", "pattern": "^[a-z0-9._-]+:[A-Za-z0-9._-]+$"},
            "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "params_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "think": {"type": ["boolean", "null"], "description": "Sent as the chat request's 'think' field; null = not sent (models without a thinking mode). Absent = false."}
          }
        }
      }
    }
  }
}
