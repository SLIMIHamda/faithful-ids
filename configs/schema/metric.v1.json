{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "configs/schema/metric.v1.json",
  "title": "Metric config (carries formula versions)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "kind", "family", "formula_version", "metrics"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "schema_version": {"const": "v1"},
    "kind": {"const": "metric"},
    "family": {"enum": ["layer1", "layer2", "meta", "plausibility", "cost"]},
    "formula_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "delta_spaces": {"type": "array", "items": {"enum": ["prob", "margin"]}, "minItems": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "formula_version"],
        "properties": {
          "name": {"type": "string"},
          "formula_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "notes": {"type": ["string", "null"]},
          "component": {"enum": ["eps_att", "eps_model", "eps_nar"]}
        }
      }
    },
    "erasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "k_values", "background_is_shap_baseline"],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "imputation_model"],
          "properties": {
            "operator": {"const": "conditional_expectation_imputation"},
            "imputation_model": {"enum": ["per_class_knn", "light_generative"]},
            "fitted_artifact_manifested": {"const": true},
            "run_parameter": {"const": "conditional"}
          }
        },
        "sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "scope", "run_parameter"],
          "properties": {
            "operator": {"const": "background_mean_imputation"},
            "scope": {"const": "invariance_check"},
            "run_parameter": {"const": "background"}
          }
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "scope"],
          "properties": {
            "operator": {"const": "retrain_roar"},
            "scope": {"const": "anchor_only"}
          }
        },
        "k_values": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "background_is_shap_baseline": {"const": false}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family", "scope", "validation"],
      "properties": {
        "model_family": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "scope": {"const": "plausibility_only"},
        "model": {"$ref": "#/$defs/pinned_ollama_model"},
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statistic", "threshold", "drop_if_below"],
          "properties": {
            "statistic": {"const": "spearman_rho_vs_human"},
            "threshold": {"type": "number"},
            "drop_if_below": {"const": true}
          }
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"family": {"const": "layer2"}}}, "then": {"required": ["erasure"]}},
    {"if": {"properties": {"family": {"const": "plausibility"}}}, "then": {"required": ["judge"]}}
  ],
  "$defs": {
    "pinned_ollama_model": {
      "type": "object",
      "description": "The pinned model the judge runs (amendment 0009): an Ollama-library 4-bit build of base_model. The run refuses to start unless the blobs Ollama serves match these sha256s. Same shape as generator.v1.json#/$defs/pinned_ollama_model.",
      "additionalProperties": false,
      "required": ["id", "provider", "quantisation", "runtime", "base_model", "weights", "ollama"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "provider": {"const": "local_open_weights"},
        "quantisation": {"enum": ["none", "4bit"]},
        "runtime": {"const": "ollama"},
        "base_model": {"type": "string"},
        "licence": {"type": "string"},
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "ref", "revision", "sha256"],
          "properties": {
            "source": {"const": "ollama_library"},
            "ref": {"type": "string", "pattern": "^[a-z0-9._-]+:[A-Za-z0-9._-]+$"},
            "revision": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_name", "template_sha256", "min_version"],
          "properties": {
            "model_name": {"type": "string", "pattern": "^[a-z0-9._-]+:[A-Za-z0-9._-]+$"},
            "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "params_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "think": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
